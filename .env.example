# MDR Automation Tool - example environment.
#
# Copy to `.env` and adjust. `.env` is git-ignored.
# Every value here is optional; the defaults are repository-relative and work
# for local development with no configuration at all.
#
# Do NOT put credentials or secrets in this file - it is committed. When the
# application eventually needs them (Phase 7 authentication), they belong in
# the deployment's own secret store, referenced by name here.

# ------------------------------------------------------------------- Data
# Root of every data directory. Default: <repo>/data
# MDR_DATA_DIR=/srv/mdr/data

# The workbook to process. Default: the first *.xlsx in data/input/current
# MDR_INPUT_WORKBOOK=/srv/mdr/data/input/current/transmittal-log.xlsx

# ---------------------------------------------------------------- Runtime
# Root log level: DEBUG | INFO | WARNING | ERROR
# MDR_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
# Default: http://localhost:5173 (the Vite dev server)
# MDR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
