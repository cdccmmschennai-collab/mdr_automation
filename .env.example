# MDR Automation Tool - example environment.
#
# Copy to `.env` and adjust. `.env` is git-ignored.
# Every value here is optional; the defaults are repository-relative and work
# for local development with no configuration at all.
#
# Do NOT put credentials or secrets in this file - it is committed. When the
# application eventually needs them (Phase 7 authentication), they belong in
# the deployment's own secret store, referenced by name here.

# ------------------------------------------------------------------- Data
# Root of every data directory. Default: <repo>/data
# MDR_DATA_DIR=/srv/mdr/data

# The workbook to process. Default: the first *.xlsx in data/input/current
# MDR_INPUT_WORKBOOK=/srv/mdr/data/input/current/transmittal-log.xlsx

# The DOC TYPE keyword rules workbook. Default: the first *.xlsx in data/rules
# When there is none, the engine still runs and leaves every DOC TYPE empty.
# MDR_RULES_WORKBOOK=/srv/mdr/data/rules/input-keywords.xlsx

# The manually prepared working file DOC TYPE is validated against.
# Default: the first *.xlsx in data/reference/working
# MDR_REFERENCE_WORKBOOK=/srv/mdr/data/reference/working/transmittal-log-8.xlsx

# Where uploaded MDR workbooks are stored, one directory per submission.
# Default: <MDR_DATA_DIR>/uploads  (/data/uploads in the docker-compose stack)
# The only data directory the API writes to on upload; input/ stays read-only.
# MDR_UPLOADS_DIR=/srv/mdr/data/uploads

# Largest upload the API accepts, in bytes. Default: 104857600 (100 MiB).
# The real MDR workbook is ~12 MB.
# MDR_MAX_UPLOAD_BYTES=104857600

# --------------------------------------------------------------- Database
# PostgreSQL connection URL. There is no default: it carries a host, a
# username and a password, none of which belong in a committed file. The
# backend runs without it - the engine, the CLI and the Excel writer need no
# database - and only the persistence layer refuses to start.
#
# `MDR_DATABASE_URL` wins over the conventional `DATABASE_URL`.
# The driver is psycopg 3, hence `+psycopg`.
#
# For the docker-compose stack, the host is the service name:
# MDR_DATABASE_URL=postgresql+psycopg://mdr:CHANGE_ME@postgres:5432/mdr
#
# For a PostgreSQL on the host machine:
# MDR_DATABASE_URL=postgresql+psycopg://mdr:CHANGE_ME@localhost:5432/mdr

# Where the persistence test suite may create throwaway databases. Unset
# means those tests skip. Point it at a development server, never production -
# the suite creates and drops databases on it.
# MDR_TEST_DATABASE_URL=postgresql+psycopg://mdr:mdr@localhost:55432/mdr

# ---------------------------------------------------------------- Runtime
# Root log level: DEBUG | INFO | WARNING | ERROR
# MDR_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
# Default: http://localhost:5173 (the Vite dev server)
# MDR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
