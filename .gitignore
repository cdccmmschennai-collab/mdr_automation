.DS_Store
Thumbs.db

# =====================================================================
# PRODUCTION DATA — never committed.
#
# The MDR workbooks are client project data. Only the intentionally
# versioned test fixtures under data/fixtures/ are tracked.
# =====================================================================
data/input/
data/reference/
data/received/
data/output/
data/rules/
# Uploaded MDR workbooks (Delivery Phase 3) are client data too. `/*` rather
# than `/` so the `.gitkeep` re-include below can reach the directory skeleton.
data/uploads/*

# The same data, wherever a run puts it. `--outdir` takes any path, so a run
# from the repository root writes engine artefacts to ./output/ and the
# automated workbook beside them - outside every rule above. These patterns
# catch the artefacts by name rather than by location, so the policy holds
# whatever directory the CLI is pointed at.
/output/
*_MDR_AUTOMATED.xlsx
documents.csv
vendor_rows.csv
exceptions.csv
automation_rows.json
mdr_phase1_result.json
validation_report.json
doc_type_report.json
sow_report.json
idb_report.json

# Excel lock files, wherever they appear
~$*.xls*

# Keep the directory skeleton so a fresh clone has somewhere to put files.
!data/**/.gitkeep

# Test fixtures ARE tracked - they are small, synthetic and part of the suite.
!data/fixtures/
!data/fixtures/**
